formulas:
  未命名: icon("arrow-right")
views:
  - type: table
    name: 表格
    filters:
      and:
        - or:
            - file.path.contains("__zettel")
            - file.path.contains("notes")
            - file.path.contains("Blogs")
    order:
      - formula.未命名
      - file.name
      - date
      - file.tags
      - file.mtime
      - author
    sort:
      - property: file.mtime
        direction: DESC
      - property: dg-publish
        direction: ASC
      - property: date
        direction: DESC
  - type: cards
    name: 视图
